fn mk() -> Big { return Big {} }

fn peek(b: Big) -> Int { return b.f0 }

fn main() -> Int {
  let i = 0
  let acc = 0
  while i < 50 {
    acc = acc + peek(Big {})
    acc = acc + peek(mk())
    i = i + 1
  }
  print_int(acc)
  return 0
}
