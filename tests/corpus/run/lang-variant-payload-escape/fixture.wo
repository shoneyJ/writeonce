fn get(ev: Ev) -> Big {
  return switch ev {
    case Boxed(b): b;
    case Tick: Big {};
  }
}

fn main() -> Int {
  let v = Boxed(Big {})
  let out = switch v {
    case Tick: Big {};
    case Boxed(b): b;
  }
  print_int(out.f0)
  let i = 0
  let acc = 0
  while i < 50 {
    let x = get(Boxed(Big {}))
    acc = acc + x.f0
    i = i + 1
  }
  print_int(acc)
  return 0
}
