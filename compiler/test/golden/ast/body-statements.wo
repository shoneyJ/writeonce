class Calc {
  items: multi Item

  fn run(mut total: Int, step: Int) -> Int {
    let base: Int = 10
    let label = "sum"
    total = total + base * 2 - 1
    let neg = -total
    if total > 100 {
      label = label .. "-big"
    } else if total > 50 {
      label = label .. "-mid"
    } else {
      label = label .. "-small"
    }
    while total > 0 {
      total = total - step
    }
    for item in self.items {
      item.touch()
      total = total + item.count
    }
    if neg > 0 {
      return
    }
    let first = self.items[0]
    let cache = PriceCache { entries: total, note: label }
    return latest(self.items).amount
  }
}

fn add(a: Int, b: Int) -> Int {
  return a + b
}
