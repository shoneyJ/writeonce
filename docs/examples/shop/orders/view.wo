-- orders/view.wo — the confirmation page and the orders table.
-- Markup-first, one HTML line per statement; see product_list/view.wo
-- for the convention and the story-37 endgame.
use html

pub class OrderOk {
  name:  Text
  qty:   Int
  total: Float

  fn render() -> Text {
    let h = "<div class='card'>";
    h = h .. "<h1>Order placed</h1>";
    h = h .. "<p>${self.qty} × ${esc(self.name)} — total € ${self.total}</p>";
    h = h .. "<p><a href='/orders'>See all orders</a> · <a href='/'>Keep shopping</a></p>";
    h = h .. "</div>";
    return h;
  }
}

pub class OrderRow {
  name:   Text
  qty:    Int
  total:  Float
  status: Text

  fn render() -> Text {
    let h = "<tr>";
    h = h .. "<td>${esc(self.name)}</td>";
    h = h .. "<td>${self.qty}</td>";
    h = h .. "<td>€ ${self.total}</td>";
    h = h .. "<td>${esc(self.status)}</td>";
    h = h .. "</tr>";
    return h;
  }
}

pub class OrdersPage {
  rows: Text

  fn render() -> Text {
    let h = "<h1>Orders</h1>";
    if self.rows == "" {
      h = h .. "<p>No orders yet — <a href='/'>go buy something</a>.</p>";
      return h;
    }
    h = h .. "<table class='orders'>";
    h = h .. "<tr><th>Product</th><th>Qty</th><th>Total</th><th>Status</th></tr>";
    h = h .. "${self.rows}";
    h = h .. "</table>";
    return h;
  }
}
