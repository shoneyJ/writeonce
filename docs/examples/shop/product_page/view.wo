-- product_page/view.wo — the product detail view with the order form.
-- Raw text literals for the bodies; see product_list/view.wo for the
-- convention.
use html

pub class ProductPage {
  sku:   Text
  name:  Text
  price: Float
  stock: Int

  fn render() -> Text {
    let action = `
      <form method="POST" action="/orders/{{ self.sku }}">
        <label>Quantity</label>
        <input type="text" name="qty" value="1" class="field">
        <button type="submit" class="btn">Buy</button>
      </form>`;
    if self.stock == 0 {
      action = `<p class="stock out">sold out</p>`;
    }
    return `
      <div class="card detail">
        <h1>{{ self.name }}</h1>
        <p class="price">€ ${self.price}</p>
        <p class="stock">${self.stock} in stock</p>
        ${action}
      </div>
      <p><a href="/">← all products</a></p>`;
  }
}
